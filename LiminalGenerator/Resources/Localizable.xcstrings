      "comment": "Numeric slider endpoint",
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "10": {
      "comment": "Numeric slider endpoint",
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "10 lo-fi hip-hop drum loops by holizna, via Freesound.org. Licensed CC0 1.0 (public domain).": {
      "comment": "Credits paragraph",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "10 Lo-Fi-Hip-Hop-Drumloops von holizna, über Freesound.org. Lizenz: CC0 1.0 (gemeinfrei)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10 loops de batería de hip-hop lo-fi de holizna, vía Freesound.org. Licencia CC0 1.0 (dominio público)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 boucles de batterie hip-hop lo-fi par holizna, via Freesound.org. Sous licence CC0 1.0 (domaine public)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "holizna による10種のローファイ・ヒップホップのドラムループ（Freesound.org 経由）。CC0 1.0（パブリックドメイン）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "10 loops de bateria de hip-hop lo-fi de holizna, via Freesound.org. Licença CC0 1.0 (domínio público)."
          }
        }
      }
    },
