{
  "sourceLanguage": "en",
  "strings": {
    "%lld generated liminal-space stills, bundled with the app and processed live through an on-device VHS filter.": {
      "comment": "Credits paragraph; %lld = number of bundled images",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld generierte Liminal-Space-Bilder, in der App enthalten und live durch einen VHS-Filter auf dem Gerät verarbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld imágenes generadas de espacios liminales, incluidas en la app y procesadas en tiempo real con un filtro VHS en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld images générées d’espaces liminaux, intégrées à l’app et traitées en direct par un filtre VHS sur l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成されたリミナルスペースの静止画%lld枚をアプリに収録し、デバイス上のVHSフィルターでリアルタイムに加工しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld imagens geradas de espaços liminares, incluídas no app e processadas em tempo real por um filtro VHS no próprio dispositivo."
          }
        }
      }
    },
    "+6dB": {
      "comment": "Numeric/dB slider endpoint",
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "-INF": {
      "comment": "Numeric/dB slider endpoint (minus infinity)",
