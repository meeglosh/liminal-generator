    "Ambient chords and melodies, generated entirely on-device, with optional lo-fi drum loops layered in.": {
      "comment": "Credits paragraph",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambient-Akkorde und -Melodien, vollständig auf dem Gerät erzeugt, optional mit Lo-Fi-Drumloops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordes y melodías ambientales generados por completo en el dispositivo, con loops de batería lo-fi opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accords et mélodies d’ambiance générés entièrement sur l’appareil, avec des boucles de batterie lo-fi en option."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンビエントなコードとメロディはすべてデバイス上で生成され、ローファイのドラムループを重ねることもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordes e melodias ambiente gerados inteiramente no dispositivo, com loops de bateria lo-fi opcionais."
          }
        }
      }
    },
    "Apple is waiting for approval or payment confirmation. Thank you for wanting to support the app.": {
      "comment": "Alert message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple wartet auf die Freigabe oder Zahlungsbestätigung. Danke, dass du die App unterstützen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple está esperando la aprobación o la confirmación del pago. Gracias por querer apoyar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple attend une approbation ou la confirmation du paiement. Merci de vouloir soutenir l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleが承認または支払いの確認を待っています。アプリを応援しようとしてくださり、ありがとうございます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple está aguardando a aprovação ou a confirmação do pagamento. Obrigado por querer apoiar o app."
          }
        }
      }
    },
