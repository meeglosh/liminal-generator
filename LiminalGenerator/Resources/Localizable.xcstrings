    "Liminal Generator is free to use. If you enjoy it, an optional tip helps support development. Tips don’t unlock additional features.": {
      "comment": "Tip jar body",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liminal Generator ist kostenlos. Wenn es dir gefällt, hilft ein freiwilliges Trinkgeld bei der Weiterentwicklung. Trinkgelder schalten keine zusätzlichen Funktionen frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liminal Generator es gratis. Si te gusta, una propina opcional ayuda a financiar su desarrollo. Las propinas no desbloquean funciones adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liminal Generator est gratuit. Si vous l’appréciez, un pourboire facultatif aide à soutenir son développement. Les pourboires ne débloquent aucune fonctionnalité supplémentaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liminal Generator は無料でお使いいただけます。気に入っていただけたら、任意のチップで開発を応援できます。チップで追加機能が使えるようになることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
